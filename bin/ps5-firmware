#!/usr/bin/env bash
# ps5-firmware: the headless half of the Omarchy plugin.
#
# One run reads the current PlayStation 5 firmware manifest, compares it with
# the previous reading, and writes the result to the plugin's state file. The
# bar widget, the panel and this command all read that one file, so there is
# exactly one implementation of every rule and one place where a bug can hide.
#
# A run always exits 0 when the source is unreachable: a monitor that cannot
# reach its source must record that fact, not crash the thing that called it.
# Exit 2 is a usage error, exit 3 is an internal error (a bug worth reporting).
#
# Dependencies: bash, jq, coreutils (flock), curl and xmllint (from libxml2, which
# is installed on any Omarchy system). jq is a declared dependency of the Omarchy
# package; curl is present on any Omarchy install.
#
# The reading comes from Sony's own update hosts: one small XML list per region,
# over https, measured against the Sony root certificate that travels with the
# plugin (lib/sony.sh). Nothing else is read, and no value is invented.
set -euo pipefail

PLUGIN_ID="io.github.danielerikssoncoder.ps5-firmware"
# What a failure message calls the source. --source replaces the source itself,
# which the test suite and any future move use.
SOURCE_LABEL="Sony's regional update lists"
SOURCE_TIMEOUT=20
# What one reply is allowed to cost. The manifest is about 47 kB today, so 1 MiB
# leaves room for it to grow by a factor of 20 and is still nowhere near filling
# a disk. This is a limit on bytes written, not on time: the source declares no
# Content-Length, so a timeout alone would still let a fast server write
# gigabytes before it fires.
SOURCE_MAX_BYTES=1048576

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PLUGIN_DIR=$(cd -- "$SCRIPT_DIR/.." && pwd)
LIB_DIR="$PLUGIN_DIR/lib"

STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
STATE_PATH="$STATE_HOME/omarchy/plugins/$PLUGIN_ID/state.json"

SOURCE=""
REGION=""
REGION_FROM_SETTING=false
MODE="once"
OUTPUT="text"
SOURCE_DOWN_NOTIFY=true
THRESHOLD=4
NOW_OVERRIDE=""
IF_STALE=0
NOTIFY=true
NOTIFY_SEND=${PS5_NOTIFY_SEND:-omarchy-notification-send}
NOTIFY_APP="PS5 firmware"

SHELL_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json

# The plugin's own settings live inline in shell.json, in whichever section the
# widget was placed. Reading them here means a terminal run behaves like the one
# the shell makes, instead of quietly using different values.
shell_setting() {
  local key=$1 fallback=$2 value=""
  if [[ -f $SHELL_CONFIG ]]; then
    value=$(jq -r --arg id "$PLUGIN_ID" --arg k "$key" '
      [ (.bar.layout // {}) | to_entries[] | .value[]
        | select(type == "object" and .id == $id) | .[$k] ]
      | map(select(. != null)) | first // empty
    ' "$SHELL_CONFIG" 2>/dev/null || true)
  fi
  if [[ -n $value ]]; then printf '%s' "$value"; else printf '%s' "$fallback"; fi
}

# What the state file is allowed to be. The directory belongs to the user, but a
# path in it can still be replaced by something that is not a file: a FIFO would
# stall a scheduled check inside the read, and an unbounded read would eat
# memory. Every read of it therefore goes through state_read, and anything that
# is not a plain file, is a link, or is larger than the cap below counts as "no
# previous reading" rather than being followed.
STATE_MAX_BYTES=1048576

# state_read <path> -> the content of a regular file that is not a link and not
# too large, otherwise nothing and a non-zero status.
state_read() {
  local path=$1 size
  [[ -f $path && ! -L $path ]] || return 1
  size=$(stat -c %s -- "$path" 2>/dev/null || echo 0)
  [[ $size =~ ^[0-9]+$ ]] || return 1
  ((size <= STATE_MAX_BYTES)) || return 1
  head -c "$STATE_MAX_BYTES" <"$path"
}

# state_json <path> -> the previous reading, or `null` when the path cannot be
# read or does not parse. This is the only door to the state file on the read
# side, so `--print`, the freshness check and the previous-state load all refuse
# the same things.
state_json() {
  local content
  content=$(state_read "$1" 2>/dev/null || true)
  if [[ -n $content ]] && jq -e . <<<"$content" >/dev/null 2>&1; then
    printf '%s' "$content"
  else
    printf 'null'
  fi
}

usage() {
  cat >&2 <<'USAGE'
Usage: ps5-firmware [--once | --print] [options]

  --once                     read the manifest, compare it, write the state file (default)
  --print                    print the state file as it stands, without touching the network
  --source <url|file>        read the manifest from there instead of Sony's own
                             regional lists (for tests and troubleshooting)
  --state <path>             state file to read and write
  --region <GLOBAL|code>     which scope the watched values and the notification follow
                             (default: the plugin's `region` setting in shell.json, else GLOBAL)
  --if-stale <seconds>       skip the check entirely when the state file is newer than this
  --now <iso8601>            timestamp to record instead of the current one (tests, backfills)
  --no-source-down-notify    never report an unreachable source
  --no-notify                record what changed but send nothing to the desktop
                             (the state file still records what would have been sent)
  --json                     with --once, print the whole state file instead of a summary
  --quiet                    print nothing on success
  -h, --help                 this text

Exit codes: 0 ran (source reachable or not), 2 bad usage, 3 internal error.
USAGE
}

while (($# > 0)); do
  case $1 in
  --once) MODE="once" ;;
  --print) MODE="print" ;;
  --source) SOURCE=${2:?--source needs a value}; shift ;;
  --state) STATE_PATH=${2:?--state needs a path}; shift ;;
  --region) REGION=${2:?--region needs a value}; shift ;;
  --if-stale) IF_STALE=${2:?--if-stale needs a value}; shift ;;
  --now) NOW_OVERRIDE=${2:?--now needs a value}; shift ;;
  --no-source-down-notify) SOURCE_DOWN_NOTIFY=false ;;
  --no-notify) NOTIFY=false ;;
  --json) OUTPUT="json" ;;
  --quiet) OUTPUT="quiet" ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "ps5-firmware: unknown argument: $1" >&2
    usage
    exit 2
    ;;
  esac
  shift
done

if [[ ! $IF_STALE =~ ^[0-9]+$ ]]; then
  echo "ps5-firmware: --if-stale needs a number of seconds, got: $IF_STALE" >&2
  exit 2
fi

[[ -n $REGION ]] || REGION=$(shell_setting region GLOBAL)

if [[ ! $REGION =~ ^(GLOBAL|[A-Za-z]{2})$ ]]; then
  echo "ps5-firmware: --region must be GLOBAL or a two-letter region code, got: $REGION" >&2
  exit 2
fi

mkdir -p "$(dirname -- "$STATE_PATH")"

if [[ $MODE == "print" ]]; then
  content=$(state_read "$STATE_PATH" || true)
  if [[ -n $content ]] && jq -e . <<<"$content" >/dev/null 2>&1; then
    jq . <<<"$content"
  else
    echo "ps5-firmware: no readable state file at $STATE_PATH" >&2
    exit 2
  fi
  exit 0
fi

# A shell restart is not a reason to ask again. The API caches its own answers
# for 30 minutes, and this machine restarts the shell on every theme change, so
# a state file that is still fresh is used as it stands.
if ((IF_STALE > 0)); then
  last=$(state_json "$STATE_PATH" | jq -r '.takenAt // empty' 2>/dev/null || true)
  if [[ -n $last ]]; then
    last_epoch=$(date -d "$last" +%s 2>/dev/null || echo 0)
    now_epoch=$(date +%s)
    if ((now_epoch - last_epoch < IF_STALE)); then
      [[ $OUTPUT == "quiet" ]] || echo "ps5-firmware: checked $((now_epoch - last_epoch))s ago, still fresh"
      exit 0
    fi
  fi
fi

# One run at a time. A shell reload while a check is in flight would otherwise
# let two runs race for the same state file. The lock file is a plain file we
# own: a link left in its place is removed rather than opened.
LOCK_PATH="$(dirname -- "$STATE_PATH")/.lock"
[[ -L $LOCK_PATH ]] && rm -f -- "$LOCK_PATH"
exec 9>"$LOCK_PATH"
if ! flock -n 9; then
  [[ $OUTPUT == "quiet" ]] || echo "ps5-firmware: another check is already running" >&2
  exit 0
fi

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

# jq gets its definitions and the program as one file: no module path, no
# installed jq layout to depend on.
compose() {
  cat "$LIB_DIR/core.jq" "$LIB_DIR/$1" >"$TMP_DIR/$1"
  printf '%s' "$TMP_DIR/$1"
}

# The Sony half of the source. It fills the same manifest every other part of
# this plugin already reads, which is why moving the source changed nothing
# downstream: the comparison, the state file and the panel all stayed put.
source "$LIB_DIR/sony.sh"

fetch() {
  local status size
  if [[ $SOURCE =~ ^https?:// ]]; then
    # --max-filesize refuses a reply that declares itself too large; the cut
    # through head caps the file on disk at the limit when the size is not known
    # until it arrives; and --speed-limit/--speed-time drop a connection that
    # trickles (under 1 kB/s for 30 s), so a stream that never ends cannot hold
    # the run either.
    #
    # --location together with --max-redirs 0 is deliberate. A redirect is a hop
    # whose target is chosen by whoever answers, and that target can be a plain
    # HTTP address on this machine or on the local network, which is never a
    # source this plugin should talk to. Following none of them means exactly one
    # host is contacted, and a redirect becomes a recorded failure instead.
    # Without --location at all, curl would hand back the redirect page as the
    # reply and the run would look like a success.
    curl --silent --show-error --location --max-redirs 0 \
      --max-time "$SOURCE_TIMEOUT" --max-filesize "$SOURCE_MAX_BYTES" \
      --speed-limit 1024 --speed-time 30 --fail "$SOURCE" 2>"$TMP_DIR/curl.err" \
      | head -c "$((SOURCE_MAX_BYTES + 1))" >"$TMP_DIR/manifest.json"
    status=${PIPESTATUS[0]}
  else
    cp -- "$SOURCE" "$TMP_DIR/manifest.json" 2>"$TMP_DIR/curl.err"
    status=$?
  fi

  # One size rule for both paths: a source that is too large is refused whether
  # it arrived over the network or from a file on this machine, and the reason a
  # reader sees is ours rather than whichever message the tool happened to print.
  # curl's exit 63 is its own "maximum file size exceeded", which happens before
  # the file can pass the limit, so it belongs to the same answer.
  size=$(wc -c <"$TMP_DIR/manifest.json" 2>/dev/null || echo 0)
  if ((size > SOURCE_MAX_BYTES)) || [[ $status == 63 ]]; then
    echo "the reply is larger than $SOURCE_MAX_BYTES bytes" >"$TMP_DIR/curl.err"
    return 1
  fi

  # curl's exit 47 with --max-redirs 0 is "a redirect was refused". The reason a
  # reader sees is ours, and it says what to do instead of only what happened.
  if [[ $status == 47 ]]; then
    echo "the source answered with a redirect, which is refused because the target can be a" \
      "local or private address - set the source to the final https address instead" \
      >"$TMP_DIR/curl.err"
    return 1
  fi
  return "$status"
}

# The previous state, or a file holding null when there is none. merge.jq and
# failure.jq both take it the same way, so neither has to know about first runs.
# state_json is the only read: a path that is a link, a FIFO or too large is not
# a previous reading, and the run starts from scratch instead of being held up by
# it.
PREV_FILE="$TMP_DIR/prev.json"
state_json "$STATE_PATH" >"$PREV_FILE"

NOW=${NOW_OVERRIDE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}

write_state() {
  # Atomic, and it does not follow anything: the content goes to a fresh file in
  # the same directory and is renamed over the target, so a name that was
  # replaced by a link in the meantime is replaced rather than written through.
  local tmp
  tmp=$(mktemp --tmpdir="$(dirname -- "$STATE_PATH")" state.XXXXXX) || return 1
  mv -- "$1" "$tmp" || return 1
  mv -- "$tmp" "$STATE_PATH"
}

# ---- telling him ------------------------------------------------------------
#
# One toast, updated in place. `notify` in the state file is what we WANT to
# say; `notified.key` is what we HAVE said. Those are deliberately not the same
# step: a toast that never reached the screen (no desktop session, the daemon
# restarting) has to stay pending so the next run tries again, instead of the
# news being swallowed as if it had been delivered. `notified` is therefore
# marked here, after a send that returned an id, and not in the jq comparison.
deliver_notification() {
  [[ $NOTIFY == true ]] || return 0

  # One validated read of the file the run just wrote, rather than four reads of
  # a path: what is decided here has to come from one consistent reading.
  local state
  state=$(state_read "$STATE_PATH" 2>/dev/null || true)
  [[ -n $state ]] || return 0

  local key
  key=$(jq -r '.notify.key // empty' <<<"$state")
  [[ -n $key ]] || return 0
  [[ $(jq -r '.notified.key // empty' <<<"$state") == "$key" ]] && return 0

  local headline body urgency
  headline=$(jq -r '.notify.headline' <<<"$state")
  body=$(jq -r '.notify.body // ""' <<<"$state")
  urgency=$(jq -r '.notify.urgency // "low"' <<<"$state")

  # The bubble we are keeping. The id lives next to the state file, so clearing
  # the plugin's state also clears it and the next change opens a fresh toast
  # rather than replacing one that is long gone. It is read and written as a
  # plain file for the same reason the state file is: a link left in its place is
  # not something to follow, and the write goes through a fresh file that is
  # renamed over it.
  local id_file previous new_id
  id_file="$(dirname -- "$STATE_PATH")/notify.id"
  previous=""
  if [[ -f $id_file && ! -L $id_file ]]; then
    previous=$(head -c 32 <"$id_file" 2>/dev/null || true)
  fi

  local replace=()
  [[ -n $previous ]] && replace=(-r "$previous")

  # -p prints the id the daemon used, also when replacing, so the next change
  # lands in the same bubble even if the id moved.
  local out rc=0
  out=$("$NOTIFY_SEND" --app-name "$NOTIFY_APP" -u "$urgency" -p "${replace[@]}" \
        "$headline" "$body" 2>&1) || rc=$?

  if ((rc != 0)); then
    local reason=${out%%$'\n'*}
    jq --arg at "$NOW" --arg error "$reason" \
      '.notifyError = {at: $at, error: $error}' <<<"$state" >"$TMP_DIR/state.json"
    write_state "$TMP_DIR/state.json"
    [[ $OUTPUT == "quiet" ]] || echo "ps5-firmware: could not show the notification: $reason" >&2
    return 0
  fi

  new_id=${out##* }
  if [[ $new_id =~ ^[0-9]+$ ]]; then
    local id_tmp
    id_tmp=$(mktemp --tmpdir="$(dirname -- "$STATE_PATH")" notify.id.XXXXXX) &&
      printf '%s\n' "$new_id" >"$id_tmp" &&
      mv -- "$id_tmp" "$id_file"
  fi

  jq --arg key "$key" --arg at "$NOW" \
    '.notified = {key: $key, at: $at} | .notifyError = null' \
    <<<"$state" >"$TMP_DIR/state.json"
  write_state "$TMP_DIR/state.json"
  [[ $OUTPUT == "quiet" ]] || echo "ps5-firmware: announced: $headline"
  return 0
}

# One source or the other: Sony's own regional lists, or whatever --source named.
if [[ -n $SOURCE ]]; then
  fetch && fetched=true || fetched=false
else
  sony_manifest && fetched=true || fetched=false
fi

if [[ $fetched == true ]] && jq -e . "$TMP_DIR/manifest.json" >/dev/null 2>&1; then
  SHAPE_PROG=$(compose shape.jq)
  jq -f "$SHAPE_PROG" "$TMP_DIR/manifest.json" >"$TMP_DIR/reading.json"

  MERGE_PROG=$(compose merge.jq)
  if ! jq --slurpfile prev "$PREV_FILE" --arg now "$NOW" --arg region "$REGION" \
    -f "$MERGE_PROG" "$TMP_DIR/reading.json" >"$TMP_DIR/state.json"; then
    echo "ps5-firmware: internal error while merging the reading (please report this)" >&2
    exit 3
  fi
  write_state "$TMP_DIR/state.json"
else
  REASON="cannot read ${SOURCE:-$SOURCE_LABEL}"
  if [[ -s $TMP_DIR/curl.err ]]; then
    REASON="$REASON: $(head -1 "$TMP_DIR/curl.err")"
  elif [[ -f $TMP_DIR/manifest.json ]]; then
    REASON="$REASON: the reply was not JSON"
  fi

  FAIL_PROG=$(compose failure.jq)
  if ! jq --slurpfile prev "$PREV_FILE" --arg now "$NOW" --arg reason "$REASON" \
    --argjson threshold "$THRESHOLD" --argjson notifyAllowed "$SOURCE_DOWN_NOTIFY" \
    -f "$FAIL_PROG" "$PREV_FILE" >"$TMP_DIR/state.json"; then
    echo "ps5-firmware: internal error while recording a source failure (please report this)" >&2
    exit 3
  fi
  write_state "$TMP_DIR/state.json"
  [[ $OUTPUT == "quiet" ]] || echo "ps5-firmware: $REASON" >&2
fi

# After the state is on disk, not before: the send is the last step, and what it
# does is recorded back into the same file (see deliver_notification).
deliver_notification

# The run's own reading, read back through the same door as everything else. It
# is a file this run just wrote, so an unreadable one is a bug rather than an
# attack, and it says so instead of printing half a state.
SUMMARY=$(state_read "$STATE_PATH" 2>/dev/null || true)

case $OUTPUT in
json)
  jq . <<<"$SUMMARY"
  ;;
quiet) ;;
*)
  jq -r '
    (.view // {}) as $v
    | "PS5 firmware: source " + (if .sourceOk then "ok" else "unreachable" end)
      + " (" + (.reading.source.health // "unknown") + ")"
      + (if .sourceOk then "" else " · " + (.failsInARow | tostring) + " in a row" end)
    , "  " + (.region) + ": latest " + ($v.latest // "?") + " · minimum " + ($v.minimum // "?")
      + " · " + ($v.status // "?")
    , "  latest unchanged since " + (.baseline.latest.since // "?")
      + " · minimum since " + (.baseline.minimum.since // "?")
    , "  changes this run: " + (if ((.events // []) | length) == 0 then "none"
                                else ([.events[] | .scope + "." + .kind] | join(", ")) end)
    , "  next notification: " + (if .notify == null then "none" else .notify.headline end)
  ' <<<"$SUMMARY"
  ;;
esac
